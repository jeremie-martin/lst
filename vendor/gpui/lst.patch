+/// lst patch: builds the system font database the way `FontSystem::new()`
+/// does through `fontdb::Database::load_system_fonts` (fontconfig
+/// directories and aliases, then cosmic-text's default families), but parses
+/// the font files on several threads. Scanning thousands of font files is
+/// dominated by per-file syscalls, which serialised took ~200 ms of a
+/// ~300 ms startup on a host with 12k font files.
+fn system_font_database() -> fontdb::Database {
+    use std::path::{Path, PathBuf};
+
+    let mut db = fontdb::Database::new();
+    let mut fontconfig = fontconfig_parser::FontConfig::default();
+    // `anyhow::Ok` is imported above, so `Result::Ok` patterns are avoided.
+    let home = std::env::var("HOME").ok();
+
+    if let Some(config_file) = std::env::var("FONTCONFIG_FILE").ok() {
+        let _ = fontconfig.merge_config(Path::new(&config_file));
+    } else {
+        let xdg_config_home = if let Some(val) = std::env::var("XDG_CONFIG_HOME").ok() {
+            Some(PathBuf::from(val))
+        } else {
+            home.as_ref().map(|home| Path::new(home).join(".config"))
+        };
+        let read_global = match xdg_config_home {
+            Some(p) => fontconfig
+                .merge_config(&p.join("fontconfig/fonts.conf"))
+                .is_err(),
+            None => true,
+        };
+        if read_global {
+            let _ = fontconfig.merge_config(Path::new("/etc/fonts/local.conf"));
+        }
+        let _ = fontconfig.merge_config(Path::new("/etc/fonts/fonts.conf"));
+    }
+
+    for fontconfig_parser::Alias {
+        alias,
+        default,
+        prefer,
+        accept,
+    } in fontconfig.aliases
+    {
+        let name = prefer
+            .first()
+            .or_else(|| accept.first())
+            .or_else(|| default.first());
+        if let Some(name) = name {
+            match alias.to_lowercase().as_str() {
+                "serif" => db.set_serif_family(name),
+                "sans-serif" | "sans serif" => db.set_sans_serif_family(name),
+                "monospace" => db.set_monospace_family(name),
+                "cursive" => db.set_cursive_family(name),
+                "fantasy" => db.set_fantasy_family(name),
+                _ => {}
+            }
+        }
+    }
+
+    let mut files = Vec::new();
+    for dir in fontconfig.dirs {
+        let path = if dir.path.starts_with("~") {
+            let Some(home) = home.as_ref() else { continue };
+            Path::new(home).join(dir.path.strip_prefix("~").unwrap_or(&dir.path))
+        } else {
+            dir.path
+        };
+        collect_font_files(&path, &mut files);
+    }
+
+    let threads = std::thread::available_parallelism()
+        .map_or(1, |count| count.get())
+        .clamp(1, 8);
+    let chunk_len = files.len().div_ceil(threads).max(1);
+    let faces: Vec<Vec<fontdb::FaceInfo>> = std::thread::scope(|scope| {
+        let handles: Vec<_> = files
+            .chunks(chunk_len)
+            .map(|chunk| {
+                scope.spawn(move || {
+                    let mut shard = fontdb::Database::new();
+                    for path in chunk {
+                        if let Err(error) = shard.load_font_file(path) {
+                            log::warn!("Failed to load '{}' cause {}.", path.display(), error);
+                        }
+                    }
+                    shard.faces().cloned().collect::<Vec<_>>()
+                })
+            })
+            .collect();
+        handles
+            .into_iter()
+            .map(|handle| handle.join().unwrap_or_default())
+            .collect()
+    });
+    for face in faces.into_iter().flatten() {
+        db.push_face_info(face);
+    }
+
+    // cosmic-text's defaults, applied after the system aliases as
+    // `FontSystem::new_with_fonts` does.
+    db.set_monospace_family("Noto Sans Mono");
+    db.set_sans_serif_family("Open Sans");
+    db.set_serif_family("DejaVu Serif");
+    db
+}
+
+/// Recursive directory scan with fontdb's extension filter, using the
+/// directory entry type instead of two `stat` calls per entry.
+fn collect_font_files(dir: &std::path::Path, files: &mut Vec<std::path::PathBuf>) {
+    let Some(entries) = std::fs::read_dir(dir).ok() else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Some(file_type) = entry.file_type().ok() else {
+            continue;
+        };
+        let file_type = if file_type.is_symlink() {
+            let Some(metadata) = std::fs::metadata(&path).ok() else {
+                continue;
+            };
+            metadata.file_type()
+        } else {
+            file_type
+        };
+        if file_type.is_dir() {
+            collect_font_files(&path, files);
+        } else if file_type.is_file()
+            && matches!(
+                path.extension().and_then(|extension| extension.to_str()),
+                Some("ttf" | "ttc" | "TTF" | "TTC" | "otf" | "otc" | "OTF" | "OTC")
+            )
+        {
+            files.push(path);
+        }
+    }
+}
