+// and do not wait for property replies on the painting path.
+fn set_window_title(xcb: &XCBConnection, window: xproto::Window, atoms: &XcbAtoms, title: &str) -> anyhow::Result<()> {
+    let legacy: Vec<u8> = title
+        .chars()
