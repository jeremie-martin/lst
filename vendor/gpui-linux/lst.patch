+// A queued animation is not fresh input demand; distinguish them without
+// exposing GPUI's private invalidator or changing its public frame API.
+#[derive(Default)]
+struct FrameDemand {
+    pending: Cell<bool>,
+    revision: Cell<u64>,
+}
+
+impl FrameDemand {
+    fn request(&self) {
+        self.revision.set(self.revision.get().wrapping_add(1));
+        self.pending.set(true);
